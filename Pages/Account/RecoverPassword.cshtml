@page
@model RecoverPasswordModel
@{
    ViewData["Title"] = "Recover password";
}

<div class="qp-auth-page">
    <div class="qp-auth-card">
        <img src="~/images/logo.svg" alt="" class="qp-auth-logo" />
        <h1 class="qp-auth-title">Forgot your password?</h1>
        <p class="text-secondary text-center">Answer the two questions you chose when you signed up.</p>

        @if (Model.Sent)
        {
            <div class="alert alert-success">
                Thanks! If the answers are correct, we will send you a link to choose a new password.
            </div>
        }

        <form method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div asp-validation-summary="All" class="alert alert-danger"></div>
            }

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Username</label>
                <input asp-for="Username" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Question1" class="form-label">Question 1</label>
                <select asp-for="Question1" asp-items="Model.Questions" class="form-select" required>
                    <option value="">Choose a question...</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Answer1" class="form-label">Answer 1</label>
                <input asp-for="Answer1" class="form-control" required />
            </div>

            <div class="mb-3">
                <label asp-for="Question2" class="form-label">Question 2</label>
                <select asp-for="Question2" asp-items="Model.Questions" class="form-select" required>
                    <option value="">Choose a question...</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Answer2" class="form-label">Answer 2</label>
                <input asp-for="Answer2" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Recover my password</button>
        </form>

        <a class="btn btn-outline-secondary w-100 mt-3" asp-page="/Account/Login">Back to log in</a>
    </div>
</div>
