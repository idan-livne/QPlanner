<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QPlanner</title>
    <link rel="icon" href="~/images/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand navbar-dark qp-navbar">
            <div class="container-fluid px-4 flex-wrap gap-2">
                <a class="navbar-brand qp-brand" asp-page="/Index">
                    <img src="~/images/logo.svg" alt="QPlanner logo" class="qp-logo" />
                    QPlanner
                </a>
                <ul class="navbar-nav me-auto flex-wrap">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/About">How it works</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Portal/Home">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Portal/CurrentQuarter">Current Q</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Portal/AllTasks">All tasks</a></li>
                </ul>
                <div class="d-flex gap-2">
                    <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">Log in</a>
                    <a class="btn btn-warning btn-sm" asp-page="/Account/Register">Sign up</a>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="qp-footer">
        <div class="container-fluid px-4">
            &copy; 2026 QPlanner &middot; Quarter planning made simple
        </div>
    </footer>
</body>
</html>
