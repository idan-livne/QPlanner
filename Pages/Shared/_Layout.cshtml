<!DOCTYPE html>
<html lang="en">
@{
    string? loggedInUser = PortalPageModel.LoggedInUser(Context.Request);
    string currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isPortalPage = currentPage.StartsWith("/Portal/");
    bool showSidebar = loggedInUser != null || isPortalPage;
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QPlanner</title>
    <link rel="icon" href="~/images/logo.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand navbar-dark qp-navbar">
            <div class="container-fluid px-4 flex-wrap gap-2">
                <a class="navbar-brand qp-brand" asp-page="/Index">
                    <img src="~/images/logo.svg" alt="QPlanner logo" class="qp-logo" />
                    QPlanner
                </a>
                <ul class="navbar-nav me-auto flex-wrap">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/About">How it works</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (loggedInUser == null)
                    {
                        <a class="btn btn-outline-light btn-sm" asp-page="/Account/Login">Log in</a>
                        <a class="btn btn-warning btn-sm" asp-page="/Account/Register">Sign up</a>
                    }
                    else
                    {
                        <span class="qp-navbar-user">@loggedInUser</span>
                        @if (loggedInUser == PortalPageModel.GuestName)
                        {
                            <span class="badge text-bg-warning">View only</span>
                        }
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @if (showSidebar)
        {
            <div class="container-fluid">
                <div class="row">
                    <partial name="_Sidebar" />
                    <section class="col-md-9 col-lg-10 @(isPortalPage ? "qp-content" : "px-0")">
                        @RenderBody()
                    </section>
                </div>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="qp-footer">
        <div class="container-fluid px-4">
            &copy; 2026 QPlanner &middot; Quarter planning made simple
        </div>
    </footer>
</body>
</html>
