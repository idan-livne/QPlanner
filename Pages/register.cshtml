@page
<div class="auth-page">
    <div class="auth-card">
        <h1>הרשמה</h1>
        <head>
            <link rel="stylesheet" href="~/css/style.css" />
        </head>
        <form method="POST">
            <div class="form-group">
                <label for="first-name">שם פרטי</label>
                <input type="text" id="first-name" name="first_name" required>
            </div>

            <div class="form-group">
                <label for="last-name">שם משפחה</label>
                <input type="text" id="last-name" name="last_name" required>
            </div>

            <div class="form-group">
                <label for="username">שם משתמש</label>
                <input type="text" id="username" name="username" required>
            </div>

            <div class="form-group">
                <label for="password">סיסמא</label>
                <input type="password" id="password" name="password" required>
            </div>

            <div class="form-group">
                <label for="email">כתובת דואר אלקטרוני</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="phone">מספר טלפון</label>
                <input type="tel" id="phone" name="phone">
            </div>

            <div class="form-group">
                <label for="dob">תאריך לידה</label>
                <input type="date" id="dob" name="dob">
            </div>

            <button type="submit" class="submit-btn">הרשם</button>
        </form>

        <div style="margin-top: 15px; text-align: center;">
            <a asp-page="/html/Index1" class="home-link-btn">חזרה לעמוד הראשי</a>
            <p style="margin-bottom: 8px;">כבר יש לך חשבון?</p>
            <a href="/login" class="orange-btn">התחבר כאן</a>
        </div>
    </div>
</div>